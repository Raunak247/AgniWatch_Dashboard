# ==============================================================================
# AgniWatch India - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your credentials.
# The application gracefully falls back to demonstrative datasets if keys are absent.

# 1. NASA FIRMS MAP Key
# Request free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# 2. OpenWeatherMap API Key
# Request free key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# 3. Google Earth Engine Cloud Project ID
# Requires an authenticated Google Cloud project with Earth Engine API enabled.
# Authenticate on local machine using: earthengine authenticate
EARTH_ENGINE_PROJECT=your_google_cloud_project_id_here
