# ==============================================================================
# AgniWatch India — Streamlit Deployment Secrets Template
# ==============================================================================
# When deploying to Streamlit Community Cloud, Hugging Face Spaces, or Docker,
# configure these secrets in the deployment settings or in .streamlit/secrets.toml.
#
# ADMINISTRATOR NOTICE:
# Authorized users of the deployed application automatically inherit these keys.
# Users are NEVER prompted to supply or expose their own API keys.
# ==============================================================================

# 1. NASA FIRMS Active Fire Area API Key
# Request free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY = "your_nasa_firms_map_key_here"

# 2. OpenWeatherMap Surface Weather API Key
# Request free key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY = "your_openweathermap_api_key_here"

# 3. Google Earth Engine Google Cloud Project ID
# Google Cloud project with Earth Engine API enabled
EARTH_ENGINE_PROJECT = "your_google_cloud_project_id_here"

# 4. Optional Administrator Dashboard PIN (default: 2026)
ADMIN_PIN = "2026"
